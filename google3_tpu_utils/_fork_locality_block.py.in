# metro -> the CNS cell the GROUP is registered in (flex registry, verified with
# `flex.par list_ceiling`; NOT `fileutil quota`, which reports a plausible
# 500.00G for an unregistered group). Used only for a cell this project's own
# _CELL_BUCKETS does not list.
_METRO_STORAGE_CELL = {
    'cbf':   'is-d',
    'ckv':   'mb-d',
    'cmh':   'go-d',
    'dfw':   'rs-d',
    'grq':   'el-d',
    'las':   'dl-d',
    'lpp':   'li-d',
    'mrn':   'qo-d',
    'sin':   'si-d',
    'tul':   'oi-d',
}

# Metros with NO group registration -- personal 500 GiB per-cell ceiling only.
_PERSONAL_ONLY_METROS = {
    'phx':   'yuphxrp-d',
    'ske':   'yuskedq-d',
}


def _metro_of(cell):
    """Measured metro for `cell`, or None. Never guesses from the name."""
    row = _CELL_LOCALITY.get((cell or '').strip().lower())
    return row[0] if row else None


def _continent_of(cell):
    """Measured continent for `cell`, or None."""
    row = _CELL_LOCALITY.get((cell or '').strip().lower())
    return row[1] if row else None


def _cns_cell_of(path):
    """'/cns/oi-d/home/x' -> 'oi-d'. None for anything that is not a /cns/ path."""
    if not isinstance(path, str) or not path.startswith('/cns/'):
        return None
    return path[len('/cns/'):].split('/', 1)[0] or None


def _assert_locality_sane():
    """Refuse to launch on a cross-metro bucket row or a drifted copy.

    TWO CHECKS, and they catch different faults:
      1. every `_CELL_BUCKETS` row must name a storage cell in the SAME METRO as
         its compute cell -- this catches a hand-edited row that quietly sends
         checkpoints to another region, which is the failure that got two jobs
         deleted (XID 275990419, XID 284145906);
      2. the measured rows must match the shared snapshot when it is reachable.
    Check 1 runs ALWAYS -- it needs nothing outside this file. Check 2 is
    skipped inside a stagedir where the source is absent, which is safe because
    the stagedir was rsynced from a checkout where check 2 had just passed.
    """
    problems = []
    for cell, path in _CELL_BUCKETS.items():
        metro = _metro_of(cell)
        store = _cns_cell_of(path)
        store_metro = _metro_of(store[:-2]) if store and store.endswith('-d') else None
        if metro is None:
            problems.append(f'  {cell} -> {path}: compute cell is not in the '
                            f'measured snapshot, so co-location cannot be proven')
        elif store_metro is None:
            problems.append(f'  {cell} -> {path}: storage cell {store!r} is not '
                            f'in the measured snapshot')
        elif metro != store_metro:
            problems.append(
                f'  {cell} ({metro}/{_continent_of(cell)}) -> {path} '
                f'({store_metro}): CROSS-METRO checkpoint row')
    if problems:
        raise SystemExit(
            '[locality] REFUSING to launch: this checkout\'s _CELL_BUCKETS has '
            'rows that are not co-located:\n' + '\n'.join(problems)
            + '\n  A checkpoint stream outside the compute metro is not a '
              'slowdown, it is a deletion by the WIM pruner.')
    try:
        with open(_LOCALITY_SOURCE) as handle:
            source = handle.read()
    except OSError:
        return
    namespace = {}
    try:
        exec(compile(source, _LOCALITY_SOURCE, 'exec'), namespace)  # noqa: S102
        truth = {c: (r[0], r[1]) for c, r in namespace['_MEASURED'].items()
                 if not c.endswith('-d')}
    except Exception as exc:  # noqa: BLE001
        raise SystemExit(
            f'[locality] cannot read {_LOCALITY_SOURCE}: {exc}. Refusing to '
            'launch with an unverifiable cell map.')
    drift = [f'  {c}: local={_CELL_LOCALITY.get(c)} source={truth.get(c)}'
             for c in sorted(set(truth) | set(_CELL_LOCALITY))
             if _CELL_LOCALITY.get(c) != truth.get(c)]
    if drift:
        raise SystemExit(
            '[locality] this checkout\'s measured cell rows have DRIFTED from '
            f'{_LOCALITY_SOURCE}:\n' + '\n'.join(drift[:20])
            + (f'\n  ... and {len(drift) - 20} more' if len(drift) > 20 else '')
            + '\n  Re-sync: python3 '
              '~/work/tpu_cmd/google3_tpu_utils/sync_fork_locality.py --write')
